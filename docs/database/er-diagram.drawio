Array></mxGeometry></mxCell><mxCell id="e_log_inv" value="入出庫" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#4B5563;strokeWidth=1.5;endArrow=ERone;startArrow=ERmany;endFill=0;startFill=0;exitX=1;exitY=0.5;entryX=1;entryY=0.5;fontColor=#1F2937;fontSize=11;" edge="1" parent="1" source="inventory_logs_inventory_id" target="inventories_id"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1325" y="895"/><mxPoint x="1325" y="549"/></Array></mxGeometry></mxCell><mxCell id="title" value="ChemStock 物理ERダイアグラム" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="40" width="700" height="40" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;&lt;font color='#6C8EBF'&gt;■&lt;/font&gt; 青系：rooms / accounts / solvents&lt;br&gt;&lt;font color='#82B366'&gt;■&lt;/font&gt; 緑系：inventories&lt;br&gt;&lt;font color='#D79B00'&gt;■&lt;/font&gt; 橙系：inventory_logs / operation_audits&lt;br&gt;&lt;font color='#808080'&gt;■&lt;/font&gt; 灰系：settings / notifications&lt;br&gt;――― 実線：物理外部キー（FK）&lt;br&gt;PK＝主キー / FK＝外部キー / UK＝一意制約（UNIQUE）&lt;br&gt;複合UNIQUE(room_id, solvent_id) は両カラムに UK 表示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;fontColor=#1F2937;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="100" y="150" width="520" height="210" as="geometry"/></mxCell><mxCell id="logic" value="&lt;b&gt;論理関係（物理FKなし・コネクタは引かない）&lt;/b&gt;&lt;br&gt;&lt;br&gt;・operation_audits(target_type, target_id) ⇢ inventory_logs / inventories / solvents / settings&lt;br&gt;　＝ ポリモーフィックな論理参照（target_type で参照先が切替）&lt;br&gt;・inventory_logs・inventories・solvents・settings ⇢ operation_audits：各操作の監査&lt;br&gt;・settings ⇢ notifications：通知判定で warning_ratio を参照&lt;br&gt;&lt;br&gt;※ 物理FKを持たないため、注記で表現している。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F8F8;strokeColor=#4B5563;fontColor=#1F2937;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1360" y="480" width="660" height="240" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>